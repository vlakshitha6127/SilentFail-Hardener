# Nebius AI Cloud / OpenAI Compatible Token Factory credentials
NEBIUS_API_KEY=your_nebius_or_nvidia_api_key_here
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1

# Models configuration
NEMOTRON_NANO_MODEL=nvidia/nemotron-mini-4b-instruct
NEMOTRON_SUPER_MODEL=nvidia/nemotron-4-340b-instruct
NEMOTRON_ULTRA_MODEL=nvidia/nemotron-4-340b-instruct

# Execution mode: 'cloud' (Nebius endpoint) or 'mock' (Deterministic local fallback)
EXECUTION_MODE=mock
SEED=42
